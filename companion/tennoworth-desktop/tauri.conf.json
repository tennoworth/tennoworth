{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TennoWorth",
  "identifier": "app.tennoworth.desktop",
  "build": {
    "frontendDist": "../../prototype/dist-desktop",
    "beforeDevCommand": "cd ../prototype && bun run build:desktop",
    "beforeBuildCommand": "cd ../prototype && bun run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "publisher": "TennoWorth",
    "copyright": "MIT licensed — https://github.com/tennoworth/tennoworth",
    "homepage": "https://tennoworth.app",
    "license": "MIT",
    "category": "Game",
    "shortDescription": "Warframe inventory + market dashboard — see what's worth selling right now",
    "longDescription": "TennoWorth reads your Warframe inventory from the running game and ranks it against live warframe.market data, so you can see what is actually worth selling right now. Works on Windows + Linux without an account. Scanning requires the game to be running; listing on warframe.market is optional.",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/tessdata/*": "tessdata/"
    },
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MzkwQjZDRDM4RDBCRUIKUldUckM0M1RiQXM1SlN2NXVDditnNUFZekpOczRhN3NxMEI2NVVlcnRsNFd4cTNnQ0tXMVJ3ZDYK",
      "endpoints": [
        "https://github.com/tennoworth/tennoworth/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
