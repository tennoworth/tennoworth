node_modules/
**/node_modules/
target/
**/target/
dist/
__pycache__/
**/__pycache__/
.pytest_cache/
.playwright-mcp/
*.tmp
rust_out

# Personal data — real companion output, never a fixture. Debug scripts
# default to these filenames; never commit the real thing.
# NOT anchored with a leading slash: the CLI writes inventory.json to its own
# working directory, so a `companion/inventory.json` slipped past the old
# /inventory.json rule and sat untracked-but-committable.
inventory.json
wfm_inventory_sellable.csv

# Scratch space for third-party binaries pulled in for compat testing
# (e.g. competitor export tools) — never redistribute someone else's binary.
/tools/

# Internal working artifacts — design exploration and research notes for
# the maintainer, not documentation for people checking the project.
/.mockups/
/.research/
/.loop-journal.md
/docs/onboarding-friction.md
/docs/rust-port-phase3.md

# AI tooling config — kept locally, not part of the public project surface.
/.claude/
/.claude.local.md

# GPG secret material for the apt/dnf repos. The signing subkey lives only on
# container 110; the primary key and revocation cert live offline. None of it
# belongs in git — a committed signing key lets anyone serve trusted packages
# to every user who added our repo. The PUBLIC key is deliberately not matched
# here: prototype/public/tennoworth-archive-keyring.asc must stay tracked.
*secret-key*.asc
*secret-subkeys*.asc
*private*.asc
*revoke*.asc
