[Unit]
Description=Check that the observation corpus is sound and complete
# OnFailure is the delivery mechanism for "not ready": the check exits non-zero
# whenever evidence is missing, so an unready corpus pages exactly like a failed
# sweep instead of waiting to be noticed in a report nobody reads.
OnFailure=wfm-alert@%n.service

[Service]
Type=oneshot
# Root, unlike the sweep: the corpus directory is 0750 wfm:wfm and the service
# health evidence is in wfm-scrape.service's journal. This process only reads
# both, and writes exactly one file, the report below.
# Where preservation lives is a deployment fact, so the deploy declares it here
# rather than letting the check fall back to a default. An undeclared mode is a
# not-ready verdict, which is why the file is optional to systemd but not to a
# green report.
EnvironmentFile=-/etc/wfm-observations-check.env
ExecStart=/srv/wfm/observations-check.sh --observations /srv/wfm/observations --out /srv/wfm/data/observations-check/report.json
Nice=10

# Nothing here needs the network or the ability to change the box; the journal
# and systemd are reached over their own sockets.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/wfm/data/observations-check
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
