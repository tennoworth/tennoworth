# Compatibility unit for a timer that may still be installed on the production
# box. Its command is deliberately a no-op until the installed timer is removed.
[Unit]
Description=Legacy package publisher compatibility no-op
After=network-online.target
Wants=network-online.target

OnFailure=wfm-alert@%n.service

[Service]
Type=oneshot
ExecStart=/srv/wfm/pull-packages.sh
