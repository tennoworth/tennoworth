# One instance per dashboard job: tennoworth-job@<id>.path starts
# tennoworth-<id>.service. Only instances root enables exist, and the publisher's
# job list (rust/tennoworth-publisher/src/ops.rs) names the same ids.
[Unit]
Description=Start tennoworth-%i when the private dashboard asks
Documentation=file:///srv/wfm/app/docs/architecture.md

[Path]
# The publisher writes a request file inside this directory, which only it can
# write to. Starting the unit while it already runs does nothing.
PathChanged=/srv/wfm/jobs/%i
Unit=tennoworth-%i.service

[Install]
WantedBy=paths.target
