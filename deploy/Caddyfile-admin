# Separate loopback listener reached only by the private Access-protected tunnel hostname.
(announcement_admin_headers) {
	header {
		Cache-Control "no-store"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

:8085 {
	bind 127.0.0.1 ::1
	root * /srv/wfm/admin/frontend/dist-admin
	encode gzip zstd
	import announcement_admin_headers
	@api path /api/announcements /api/announcements/* /api/status /api/jobs/*
	skip_log @api
	handle @api {
		reverse_proxy 127.0.0.1:8084 {
			header_up -Cookie
			header_up -Authorization
			# Preserve Cf-Access-Jwt-Assertion: the publisher verifies its signature.
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}
	handle_errors {
		import announcement_admin_headers
		@unavailable expression {http.error.status_code} >= 500
		respond @unavailable "Private publishing is unavailable." 503
		respond "Request could not be served." {http.error.status_code}
	}
	handle {
		rewrite / /admin.html
		file_server
	}
}
