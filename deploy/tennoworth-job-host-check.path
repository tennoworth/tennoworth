[Unit]
Description=Start the host check when the private dashboard asks
Documentation=file:///srv/wfm/app/docs/architecture.md

[Path]
# The publisher writes a request file inside this directory, which only it can
# write to. Starting the unit while it already runs does nothing.
PathChanged=/srv/wfm/jobs/host-check
Unit=tennoworth-host-check.service

[Install]
WantedBy=paths.target
