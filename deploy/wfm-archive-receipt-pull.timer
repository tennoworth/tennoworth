[Unit]
Description=Fetch the observation archive receipt

[Timer]
# Hourly, ahead of the readiness check: the archive deadline is 36 hours, and a
# deadline evaluated once a day can breach and go unnoticed for most of another
# day. UTC is explicit because an OnCalendar without it follows the host's local
# time, and this elapse only makes sense relative to the box's own clock.
OnCalendar=*-*-* *:15:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
