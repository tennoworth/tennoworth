# RETIRED - see wfm-repo-pull.service. Fires a no-op stub; kept only so the
# already-enabled timer on the box has something harmless to run until it is
# disabled.
[Unit]
Description=Retired - was: check for a new desktop release every 30 minutes

[Timer]
# Slower than the web pull (15min): desktop releases are cut by hand from a
# tag, not republished on every push, so a tighter interval would just be
# GitHub API calls that always find the same tag.
OnBootSec=5min
OnUnitActiveSec=30min
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
