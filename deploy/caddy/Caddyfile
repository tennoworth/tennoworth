# Warframe market dashboard - a SITE BLOCK to add to your EXISTING Caddyfile.
#
# You already run Caddy + a Cloudflare Tunnel, so DON'T replace your Caddyfile
# with this - paste this block in (or `import` it). Pick a localhost port that's
# free on your box (8080 is a common collision; 8081 used here), point a NEW
# tunnel public hostname (e.g. wfm.yourdomain.com -> http://localhost:8081) at
# it, and adjust the port below to match.
#
# Bound to loopback below - the tunnel reaches it; nothing else can. A bare
# `:8081` with no `bind` listens on every interface, so the boundary has to be
# stated rather than assumed.

# Proxying shared by the opt-in collectors: client identity headers never reach
# the loopback service, and a stalled service fails fast instead of holding the
# connection. Imported inside each collector's reverse_proxy block.
(collector_upstream) {
	header_up -Forwarded
	header_up -X-Forwarded-For
	header_up -X-Real-IP
	header_up -CF-*
	header_up -Cookie
	header_up -Authorization
	header_up -User-Agent
	header_up -Referer
	transport http {
		dial_timeout 2s
		response_header_timeout 5s
	}
}

# Security headers. This is the only place the site's real HTTP headers are set;
# the site and its error routes both import it, because error routes do not
# inherit the site's headers. The CSP line is kept in sync by
# scripts/sync-csp.ts. HSTS is `max-age` only on
# purpose: adding `includeSubDomains; preload` is an APEX-WIDE, hard-to-undo
# commitment (it forces HTTPS on every sibling subdomain for a year, and `preload`
# gets baked into browsers). That's wrong for a single subdomain sharing a domain
# with your other services. Re-add those two only if you own the apex and intend
# HTTPS across ALL of it. Verify the headers land:
#   curl -sI https://wfm.yourdomain.com | grep -iE 'strict-transport|frame|content-security'
(public_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

:8081 {
	# Both loopback addresses. `localhost` resolves to ::1 on hosts where IPv6 is
	# preferred (this one included), and cloudflared dials `localhost` - so
	# binding only 127.0.0.1 leaves the tunnel with no listener to reach.
	bind 127.0.0.1 ::1
	root * /srv/wfm/app/frontend/dist
	# zstd first: Caddy prefers config order when the browser accepts both.
	# `better` sends market.json at ~386 KB instead of gzip's ~438 KB for ~14 ms
	# of CPU; `best` saves 14 KB more for three times the CPU on every request.
	encode {
		zstd better
		gzip
	}

	import public_headers

	handle /wfm-policy.json {
		root * /srv/wfm/policy
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	# Point this at the publisher's export directory only after the publisher has
	# written its first export there; never copy a feed into it by hand. A configured
	# but missing export returns 404 rather than reviving bundled content.
	handle /announcements.json {
		root * {$TENNOWORTH_ANNOUNCEMENT_FEED_ROOT:/srv/wfm/app/frontend/dist}
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	# Live, cron-refreshed data files from public/ (shadow the stale copies Vite
	# bakes into dist/). wfstat-catalog.json backs the inventory resolver - the
	# browser stopped fetching warframestat directly when upstream dropped CORS.
	# Its own handle block so routing is unambiguous.
	# definitions.json (C7) is here for the same reason and one more: its whole
	# purpose is fixing a broken scan WITHOUT a release, so it must be editable
	# in place on the box. Served from dist/ it would need a web rebuild+deploy,
	# which is the exact latency it exists to avoid. Clients install it only as a
	# signed envelope (docs/wfm-access.md), so editing it in place still needs the
	# offline signing key.
	# history.json (relics.run-derived, box-only state) is live data too.
	# market-public.json is the slim copy the prerendered pages refresh from, and
	# market-home.json the homepage's copy without desktop-only fields.
	@livedata path /market.json /market.json.minisig /market-public.json /market-home.json /wfstat-catalog.json /history.json /history.json.minisig
	handle @livedata {
		root * /srv/wfm/data/public
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}
	# The scan hotfix file is tracked, so it is served from the checkout: a
	# change reaches users with the next pull, not the next release.
	handle /definitions.json {
		root * /srv/wfm/app/frontend/public
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# Keep removed package endpoints out of the SPA fallback. A 200 containing
	# index.html looks like corrupt repository metadata; 410 says unambiguously
	# that the old source must be removed from the machine's package-manager
	# configuration. Keep this tombstone even though no archive files remain.
	@removedPackages path /apt /apt/* /rpm /rpm/* /tennoworth-archive-keyring.asc
	handle @removedPackages {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		respond "TennoWorth package repositories have been removed. Use the Linux AppImage from https://github.com/tennoworth/tennoworth/releases/latest\n" 410
	}

	@usage path /api/usage/check-in /api/usage/daily
	# Keep compatibility with the distribution Caddy used by deployment checks.
	skip_log @usage
	handle @usage {
		reverse_proxy 127.0.0.1:8082 {
			import collector_upstream
		}
	}

	# Price reports: the same stripped, unlogged proxying as the usage counter,
	# to its own loopback service (docs/price-reports.md).
	@reports path /api/reports/*
	skip_log @reports
	handle @reports {
		reverse_proxy 127.0.0.1:8083 {
			import collector_upstream
		}
	}

	# Handled proxy outages stay out of runtime error logs, which otherwise include client metadata.
	# Keep debug logging disabled in production.
	handle_errors {
		import public_headers
		@usageError path /api/usage/check-in /api/usage/daily
		respond @usageError "Usage counts are currently unavailable." 503
		@reportsError path /api/reports/*
		respond @reportsError "Price reports are currently unavailable." 503
		# Missing pages get the built 404 page. file_server inside handle_errors keeps
		# the error status, so this stays a real 404 rather than a soft one. The root is
		# restated because the live-data and announcement handlers point elsewhere;
		# API paths keep their plain-text errors.
		@notFound {
			expression {http.error.status_code} == 404
			not path /api/*
		}
		handle @notFound {
			root * /srv/wfm/app/frontend/dist
			rewrite * /404.html
			file_server
		}
		respond "{http.error.status_text}" {http.error.status_code}
	}

	# Public pages are physical directories with index.html. Missing paths must
	# return 404 instead of indexing homepage copies.
	handle {
		# Missing chunks must not pin a 404 in browser or CDN caches.
		@assets {
			path /assets/*
			file {path}
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

# The private announcement dashboard's own loopback listener. It is reachable
# only through the Access-protected admin hostname; importing it keeps the
# installed copy comparable with this file.
import Caddyfile-admin
