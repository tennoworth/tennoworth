[Unit]
Description=Archive the box's observation logs to this host
Wants=network-online.target
After=network-online.target
# Runs on the archive host, not on the box. A failed run alerts here; a run that
# never happens is caught from the other side, because the receipt it publishes
# ages and the box's readiness check rejects a stale one.
OnFailure=wfm-alert@%n.service

[Service]
Type=oneshot
# HOST, SSH, SCP, SOURCE_DIR, DEPLOYED and DEST for the archive run.
EnvironmentFile=-/etc/tennoworth-archive.env
# Install this script here (or point the unit at the checkout) and make sure the
# account can only read the box: the archive never writes to it.
ExecStart=/usr/local/bin/archive-observations.sh
Nice=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
