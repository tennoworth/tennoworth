[Unit]
Description=Check the observation corpus

[Timer]
# Hourly, so a corpus that stops being sound is reported within the hour rather
# than at the next daily evaluation. UTC is explicit because an OnCalendar
# without it follows the host's local time.
OnCalendar=*-*-* *:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
