# Warframe market dashboard — a SITE BLOCK to add to your EXISTING Caddyfile.
#
# You already run Caddy + a Cloudflare Tunnel, so DON'T replace your Caddyfile
# with this — paste this block in (or `import` it). Pick a localhost port that's
# free on your box (8080 is a common collision; 8081 used here), point a NEW
# tunnel public hostname (e.g. wfm.yourdomain.com -> http://localhost:8081) at
# it, and adjust the port below to match.
#
# Binds to loopback only — the tunnel reaches it; nothing else can.

:8081 {
	root * /srv/wfm/app/prototype/dist
	encode gzip zstd

	# Security headers — from prototype/public/_headers, with ONE deliberate change:
	# HSTS here is `max-age` only. The canonical set adds `includeSubDomains; preload`,
	# which is an APEX-WIDE, hard-to-undo commitment (it forces HTTPS on every sibling
	# subdomain for a year, and `preload` gets baked into browsers). That's wrong for a
	# single subdomain sharing a domain with your other services. Re-add those two only
	# if you own the apex and intend HTTPS across ALL of it. Verify the headers land:
	#   curl -sI https://wfm.yourdomain.com | grep -iE 'strict-transport|frame|content-security'
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Live, cron-refreshed data files from public/ (shadow the stale copies Vite
	# bakes into dist/). wfstat-catalog.json backs the inventory resolver — the
	# browser stopped fetching warframestat directly when upstream dropped CORS.
	# Its own handle block so routing is unambiguous.
	# definitions.json (C7) is here for the same reason and one more: its whole
	# purpose is fixing a broken scan WITHOUT a release, so it must be editable
	# in place on the box. Served from dist/ it would need a web rebuild+deploy,
	# which is the exact latency it exists to avoid.
	# history.json (relics.run-derived, box-only state) is live data too.
	@livedata path /market.json /wfstat-catalog.json /definitions.json /history.json
	handle @livedata {
		root * /srv/wfm/app/prototype/public
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# RETIRED BUT STILL SERVED. Linux is AppImage-only; nothing publishes into
	# the apt/dnf repos any more (deploy/pull-packages.sh is a no-op stub). The
	# two routes below stay because REMOVING them is what would break people:
	# an existing `apt install tennoworth` user would get index.html with a 200
	# from the SPA catch-all instead of InRelease, which apt reports as a
	# corrupt repository rather than as "this repo is gone". Left as-is, their
	# package manager keeps verifying a valid signed tree that simply never
	# offers a new version. Take these down only together with /srv/wfm/repo,
	# and only after the change has been announced.

	# The repo signing key. It needs its OWN handle, not the SPA catch-all:
	# that ends in `try_files {path} /index.html`, so a miss would return
	# index.html with status 200. The documented install line is
	#   curl -fsSL .../tennoworth-archive-keyring.asc | sudo tee /etc/apt/keyrings/...
	# and `curl -f` does not fire on a 200 — the user would silently write HTML
	# into their keyring and hit an unexplainable signature failure on the next
	# `apt update`. Served from public/ (git-tracked, present without waiting
	# for a web bundle rebuild) so a miss is a real 404.
	@repokey path /tennoworth-archive-keyring.asc
	handle @repokey {
		root * /srv/wfm/app/prototype/public
		header Content-Type "application/pgp-keys"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Signed apt + dnf repositories. FROZEN — wfm-repo-pull.timer no longer
	# publishes into them (see the retirement note above). Served from a
	# separate root; the URL path already carries the /apt or /rpm prefix, so
	# root + path resolves without a strip_prefix.
	#
	# No file_server `browse` — apt and dnf fetch exact paths (dists/…/InRelease,
	# repodata/repomd.xml) and never need an index. Directory listings would only
	# expose the pool layout.
	@repo path /apt/* /rpm/*
	handle @repo {
		root * /srv/wfm/repo
		# Metadata must not go stale: a cached InRelease/repomd.xml that no
		# longer matches the pool makes apt/dnf fail checksum verification,
		# which reads to users as a corrupt repo. Packages themselves are
		# immutable per version, so they can be cached hard.
		@immutable path /apt/pool/* /rpm/*.rpm
		header Cache-Control "public, max-age=300, must-revalidate"
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: the SPA. Wrapped in a catch-all handle so we never mix a
	# handle block with bare file_server/try_files (Caddy's directive ordering
	# there is surprising). try_files rewrites unknown paths to index.html.
	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
