[Unit]
Description=Refresh Warframe market.json from warframe.market + warframestat
Wants=network-online.target
After=network-online.target

OnFailure=tennoworth-alert@%n.service

[Service]
Type=oneshot
User=wfm
Group=wfm
WorkingDirectory=/srv/wfm/data/scrape
ExecStart=/srv/wfm/run-scrape.sh
# Actual runtime crept past 3600s (item count + pacing grew) and systemd was
# killing the scrape a few hundred seconds short of writing market.json -
# every run for ~14h just re-served the last successful snapshot.
TimeoutStartSec=7200
Nice=10

# Sandboxing - the sweep writes its own state and what the site serves, and
# nothing else; the checkout is read-only to it.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/wfm/data/scrape /srv/wfm/data/public
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
