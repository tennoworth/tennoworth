{
  "name": "tennoworth-frontend",
  "overrides": {
    "devalue": "^5.9.2",
    "zod": "^4.6.7",
    "undici": "^7.30.1"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "bun ../scripts/check-announcements.ts && bun ../scripts/release.ts app-notes --check && bun ../scripts/sync-csp.ts --check && bun ../scripts/build-icons.ts --check",
    "build": "vite build --manifest && bun scripts/prerender.ts",
    "build:desktop": "bun ../scripts/check-announcements.ts && bun ../scripts/release.ts app-notes --check && bun ../scripts/sync-csp.ts --check && bun ../scripts/build-icons.ts --check && vite build --outDir dist-desktop --emptyOutDir && bun ../scripts/sync-csp.ts --desktop dist-desktop/index.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:responsive": "playwright test --project=chromium",
    "test:responsive:all": "playwright test",
    "build:domain-wasm": "bun ../scripts/build-domain-wasm.ts",
    "check": "svelte-check",
    "knip": "knip && knip --production",
    "csp": "bun ../scripts/sync-csp.ts",
    "icons": "bun ../scripts/build-icons.ts --raster",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "bun ../scripts/sync-csp.ts --check && vite build --config vite.admin.config.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:public-site": "bun run build && playwright test --config playwright.public.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
