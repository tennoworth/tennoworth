msgid "Refresh ▾"
msgstr "Yenile ▾"

#. The same button while a scan runs.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.refreshing"
msgid "Scanning…"
msgstr "Taranıyor…"

#. Tooltip on the Refresh button.
#, fuzzy
msgctxt "strip.refreshTitle"
msgid "Load fresh inventory - re-fetch from the game. Export / Restore / Clear live in this menu too."
msgstr "Envanteri oyundan yeniden yükle. Dışa aktar, Geri yükle ve Temizle de bu menüde."

#. Tooltip on the Refresh button while scanning.
#, fuzzy
msgctxt "strip.refreshingTitle"
msgid "Reading the running game’s memory - this can take a few seconds."
msgstr "Çalışan oyunun belleği okunuyor - birkaç saniye sürebilir."

#. Scan menu, first line.
#, fuzzy
msgctxt "strip.menuLede"
msgid "Scan the running game - no file needed."
msgstr "Çalışan oyunu tara - dosya gerekmez."

#. Scan menu button.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.scanGame"
msgid "Scan game"
msgstr "Oyunu tara"

#. Scan menu button: save an encrypted copy of the inventory.
#. Max 18 characters.
#, fuzzy
msgctxt "strip.export"
msgid "Export…"
msgstr "Dışa aktar…"

#. Tooltip on Export.
#, fuzzy
msgctxt "strip.exportTitle"
msgid "Download an encrypted snapshot for another device or backup."
msgstr "Başka bir cihaz veya yedek için şifreli bir kopya indir."

#. Scan menu button: load an exported copy.
#. Max 18 characters.
#, fuzzy
msgctxt "strip.restore"
msgid "Restore…"
msgstr "Geri yükle…"

#. Tooltip on Restore.
#, fuzzy
msgctxt "strip.restoreTitle"
msgid "Restore an encrypted snapshot exported from another device."
msgstr "Başka bir cihazdan dışa aktarılan şifreli kopyayı geri yükle."

#. Scan menu, confirmation question before clearing.
#, fuzzy
msgctxt "strip.clearAsk"
msgid "Forget the saved scan? Scan again to get it back."
msgstr "Kayıtlı tarama unutulsun mu? Yeniden tarayarak geri alabilirsin."

