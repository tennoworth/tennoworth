#. Max 14 characters.
#, fuzzy
msgctxt "strip.savedScan"
msgid "Saved scan"
msgstr "Kayıtlı tarama"

#. Status bar, inventory cell label.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.inventory"
msgid "Inventory"
