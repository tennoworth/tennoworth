#. Desktop first-run page, the main heading. Shown in capitals.
#. Max 40 characters.
#, fuzzy
msgctxt "firstRun.heading"
msgid "Get your personal sell list"
msgstr "Tu lista de venta personal"

#. First-run page, under the heading. Keep <em>…</em> around the word that is stressed.
#, fuzzy
msgctxt "firstRun.pitch"
msgid "Scan once and TennoWorth ranks <em>your</em> inventory by what to sell right now."
msgstr "Escanea una vez y TennoWorth ordena <em>tu</em> inventario según lo que conviene vender ahora."

#. First-run page, a condition for scanning.
#, fuzzy
msgctxt "firstRun.requirement"
msgid "Warframe must be open and past the login screen."
msgstr "Warframe debe estar abierto y pasada la pantalla de inicio de sesión."

#. First-run page, the main button. Reads the game's inventory.
#. Max 26 characters.
#, fuzzy
msgctxt "firstRun.scan"
msgid "Scan inventory"
msgstr "Escanear inventario"

#. The same button while a scan runs.
#. Max 26 characters.
#, fuzzy
msgctxt "firstRun.scanning"
msgid "Scanning game…"
msgstr "Escaneando el juego…"

#. First-run page, privacy line under the button.
#, fuzzy
msgctxt "firstRun.trust"
msgid "Reads the running game's memory only - nothing leaves your machine."
msgstr "Solo lee la memoria del juego en ejecución: nada sale de tu equipo."

#. First-run page, label above the market search. Shown in capitals.
#. Max 32 characters.
#, fuzzy
msgctxt "firstRun.lookup"
msgid "Or look anything up"
msgstr "O busca cualquier cosa"

#. Status bar next to the brand on the first-run page. Cut short when space runs out.
#, fuzzy
msgctxt "strip.tagline"
msgid "warframe.market prices, ranked by what actually sells"
msgstr "Precios de warframe.market, ordenados por lo que de verdad se vende"

#. Status bar, inventory cell before the first scan.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.noInventory"
msgid "No inventory yet"
msgstr "Aún no hay inventario"

#. Status bar, inventory cell while the saved scan loads.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.loadingScan"
msgid "Loading saved scan…"
msgstr "Cargando escaneo…"

#. Status bar, inventory cell: the inventory came from an imported file.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.imported"
msgid "Imported"
msgstr "Importado"

#. Status bar, inventory cell: showing the last saved scan.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.savedScan"
msgid "Saved scan"
msgstr "Escaneo guardado"

#. Status bar, inventory cell label.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.inventory"
msgid "Inventory"
msgstr "Inventario"

#. Status bar, when a scan has no time.
#, fuzzy
msgctxt "strip.timestampUnavailable"
msgid "Timestamp unavailable"
msgstr "Hora desconocida"

#. Status bar, after a failed rescan.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.refreshFailed"
msgid "Last refresh failed"
msgstr "Falló la actualización"

#. Status bar button that opens the scan menu. Keep the ▾.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.refresh"
msgid "Refresh ▾"
msgstr "Actualizar ▾"

#. The same button while a scan runs.
#. Max 14 characters.
#, fuzzy
msgctxt "strip.refreshing"
msgid "Scanning…"
msgstr "Escaneando…"

#. Tooltip on the Refresh button.
#, fuzzy
msgctxt "strip.refreshTitle"
msgid "Load fresh inventory - re-fetch from the game. Export / Restore / Clear live in this menu too."
msgstr "Cargar el inventario de nuevo desde el juego. Exportar, Restaurar y Borrar también están en este menú."

#. Tooltip on the Refresh button while scanning.
#, fuzzy
msgctxt "strip.refreshingTitle"
msgid "Reading the running game’s memory - this can take a few seconds."
msgstr "Leyendo la memoria del juego en ejecución; puede tardar unos segundos."

#. Scan menu, first line.
#, fuzzy
msgctxt "strip.menuLede"
msgid "Scan the running game - no file needed."
msgstr "Escanea el juego en ejecución; no hace falta ningún archivo."

#. Scan menu button.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.scanGame"
msgid "Scan game"
msgstr "Escanear el juego"

#. Scan menu button: save an encrypted copy of the inventory.
#. Max 18 characters.
#, fuzzy
msgctxt "strip.export"
msgid "Export…"
msgstr "Exportar…"

#. Tooltip on Export.
#, fuzzy
msgctxt "strip.exportTitle"
msgid "Download an encrypted snapshot for another device or backup."
msgstr "Descarga una copia cifrada para otro equipo o como respaldo."

#. Scan menu button: load an exported copy.
#. Max 18 characters.
#, fuzzy
msgctxt "strip.restore"
msgid "Restore…"
msgstr "Restaurar…"

#. Tooltip on Restore.
#, fuzzy
msgctxt "strip.restoreTitle"
msgid "Restore an encrypted snapshot exported from another device."
msgstr "Restaura una copia cifrada exportada desde otro equipo."

#. Scan menu, confirmation question before clearing.
#, fuzzy
msgctxt "strip.clearAsk"
msgid "Forget the saved scan? Scan again to get it back."
msgstr "¿Olvidar el escaneo guardado? Vuelve a escanear para recuperarlo."

#. Scan menu, confirms clearing.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.clearConfirm"
msgid "Clear saved scan"
msgstr "Borrar escaneo"

#. Scan menu, cancels clearing.
#. Max 22 characters.
#, fuzzy
msgctxt "strip.clearKeep"
msgid "Keep it"
msgstr "Conservarlo"

#. Scan menu button that asks before clearing.
#. Max 18 characters.
#, fuzzy
msgctxt "strip.clear"
msgid "Clear…"
msgstr "Borrar…"

#. Tooltip on Clear.
#, fuzzy
msgctxt "strip.clearTitle"
msgid "Forget the saved inventory entirely."
msgstr "Olvida por completo el inventario guardado."

#. Tooltip on the inventory cell. count is a number of items; summary lists them by kind, in English.
#, fuzzy
msgctxt "strip.unmatched"
msgid "{count, plural, one {# item couldn't be price-matched} other {# items couldn't be price-matched}} ({summary}) - usually untradeable blueprints, quest items and very new content."
msgstr "{count, plural, one {# objeto sin precio asociado} other {# objetos sin precio asociado}} ({summary}): normalmente planos no comerciables, objetos de misión y contenido muy reciente."

#. Scan menu note. count is a number of items.
#, fuzzy
msgctxt "strip.unmatchedNote"
msgid "{count, plural, one {# item couldn't be price-matched} other {# items couldn't be price-matched}} (not shown) - usually untradeable blueprints, quest items and very new content; your sellable items aren't affected."
msgstr "{count, plural, one {# objeto sin precio asociado} other {# objetos sin precio asociado}} (no se muestran): normalmente planos no comerciables, objetos de misión y contenido muy reciente; tus objetos vendibles no se ven afectados."

#. Tooltip on that note; summary lists items by kind, in English.
#, fuzzy
msgctxt "strip.unmatchedBreakdown"
msgid "Breakdown: {summary}."
msgstr "Desglose: {summary}."

#. Status bar note after a scan that found nothing to sell.
#, fuzzy
msgctxt "strip.noTradeables"
msgid "No tradeable items found; showing saved inventory"
msgstr "No se encontraron objetos comerciables; se muestra el inventario guardado"

#. Screen reader label for the inventory status dot.
#, fuzzy
msgctxt "strip.inventoryFailedLabel"
msgid "Inventory refresh failed"
msgstr "Falló la actualización del inventario"

#. Screen reader label for the inventory status dot. age is like "12 h ago" (English for now).
