{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-export gate. The class it exists for: checkUpdate, desktopWfmLogout
  // and clearCached all sat exported-and-uncalled for months. tsconfig's
  // noUnusedLocals cannot see any of them - it flags unused LOCALS, never unused
  // EXPORTS.
  //
  // Public shapes may contain named types used only inside their defining
  // module. Those members remain part of the consuming contract.
  //
  // Known gaps, so nobody reads more cover into this than there is: unused
  // IMPORTS inside a .svelte file stay invisible (knip reports unused exports,
  // files and dependencies, not per-file imports), and @vitest/ui is treated as
  // used because knip's vitest plugin knows it as an optional peer.
  "ignoreExportsUsedInFile": true,

  // knip's svelte plugin hard-codes `svelte.config.js` as its only config
  // entry (no .ts variant), so a TypeScript svelte.config reports as an unused
  // file. It IS the toolchain's config; declare it as the entry explicitly.
  // The vite.config.ts glob the svelte plugin would otherwise inherit comes
  // from the vite plugin's own config and is unaffected by this override.
  "svelte": {
    "entry": ["svelte.config.ts"]
  },

  // These two tests read the whole source tree as text through
  // import.meta.glob(..., { query: '?raw' }). knip treats every glob pattern as
  // a real import and ignores the query, so as entries they marked every
  // export in src/ as used and the gate above passed without seeing anything -
  // from 2026-09-07 until this exclusion. They are not entries, and not unused
  // files either: vitest runs them.
  "vitest": {
    "entry": ["src/**/*.test.{ts,svelte}", "!src/dev/architecture.test.ts", "!src/dev/design-system.test.ts"]
  },
  "ignore": ["src/dev/architecture.test.ts", "src/dev/design-system.test.ts"]
}
